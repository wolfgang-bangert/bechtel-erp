{
  "name": "werk",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "restart": "bash scripts/restart-web.sh",
    "stop": "lsof -nP -tiTCP:3000 -sTCP:LISTEN | xargs kill 2>/dev/null || true",
    "build": "pnpm --filter web build",
    "db:push": "pnpm --filter @werk/db push",
    "db:reset": "pnpm --filter @werk/db reset",
    "db:diff": "pnpm --filter @werk/db diff",
    "db:status": "pnpm --filter @werk/db status",
    "gen:types": "pnpm --filter @werk/db gen:types"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
