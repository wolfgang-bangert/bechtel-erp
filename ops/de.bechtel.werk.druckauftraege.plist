<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.bechtel.werk.druckauftraege</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/wolfgangbangert/neues ERP/scripts/druckauftraege-holen.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/wolfgangbangert/.local/node/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/wolfgangbangert/neues ERP</string>

  <!-- täglich um 05:30 Uhr -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- verpasste Läufe (Rechner war aus) beim nächsten Start nachholen -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/wolfgangbangert/neues ERP/logs/druckauftraege.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/wolfgangbangert/neues ERP/logs/druckauftraege.launchd.log</string>
</dict>
</plist>
