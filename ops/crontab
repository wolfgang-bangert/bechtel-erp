# supercronic-Crontab für den sync-Container (Zeitzone via TZ im compose).
# Format: m h dom mon dow  command
# Ersetzt die bisherigen launchd-Agents vom Mac.

# Druckaufträge aus den Kundenportalen holen + auflösen + bejobben (war 05:30)
30 5 * * *   cd /app/services/sync && pnpm portal:pull --portal=onlineprinters

# Keyline-Abgleich Aufträge + Rechnungen (war alle 30 min) - danach
# invoice:bookings (Debitor an Erlöskonto je neu eingespielter Rechnung),
# bank:match (gegen bereits vorhandene offene Bankbuchungen, sonst erst
# beim nächsten Bank-Abruf) und skonto:apply (Skonto-Restbeträge als
# eigene Buchungszeile ausbuchen - erst sinnvoll nachdem bank:match die
# Zahlungen zugeordnet hat).
*/30 * * * *  cd /app/services/sync && pnpm keyline:orders && pnpm keyline:invoices && pnpm invoice:bookings && pnpm bank:match && pnpm skonto:apply

# Ninox-Rechnungen (Kalender-Vertrieb) - nur für Buchhaltung freigegebene,
# per Default seit Jahresbeginn (siehe syncNinoxInvoices) - + PDFs dazu,
# gleicher Grund für invoice:bookings/bank:match/skonto:apply danach wie
# bei Keyline oben
*/30 * * * *  cd /app/services/sync && pnpm ninox:invoices && pnpm pdf:invoices && pnpm invoice:bookings && pnpm bank:match && pnpm skonto:apply

# Ausgangsrechnungen aus Ninox-Apps außerhalb von Keyline (D-TACK/Kohlhammer: sobald "Rechnung an
# Kunde gesendet" gesetzt ist; Euchner: mit PDF + Rechnungsnummer): PDF holen, per KI lesen, als
# Ausgangsrechnung mit Erlösbuchung anlegen (seit Jahresbeginn; schon vorhandene werden übersprungen).
# Danach bank:match/skonto:apply wie bei Keyline.
20 6 * * *   cd /app/services/sync && pnpm ninox:rechnungen-extern && pnpm bank:match && pnpm skonto:apply

# EZB-Wechselkurse (Fremdwährungsbelege in der UStVA umrechnen) - werktäglich nach der Veröffentlichung
30 17 * * 1-5   cd /app/services/sync && pnpm fx:ecb

# Bankgebühren/Zinsen (Kontoführung, Spesen, Kartenentgelt, Sollzinsen, Kreditbereitstellung ...) als Sonderbuchung buchen
40 6 * * *   cd /app/services/sync && pnpm bank:gebuehren

# Eingangsrechnungen aus dem Postfach + KI-Vorerfassung (war stündlich)
15 * * * *   cd /app/services/sync && pnpm mail:fetch --since=7 && pnpm incoming:extract --limit=100

# Bankumsätze abrufen (FinTS): Zeitplan liegt jetzt in n8n (Tag "werk",
# Workflow "werk – Bank-Sync Zeitplan"), das ruft POST /api/n8n/trigger auf
# und legt damit eine sync_request-Zeile an. Dieser Cron-Job bleibt der
# Abarbeiter für JEDE sync_request – egal ob von n8n, dem "Banken
# aktualisieren"-Button oder künftig anderen Quellen angelegt.
*/2 * * * *  cd /app/services/sync && pnpm requests:process
