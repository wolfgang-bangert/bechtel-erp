# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# services/sync – CLI-Worker (tsx). Läuft als Cron-Container via supercronic.
# Enthält zusätzlich ein Python-venv für die FinTS-Anbindung (fints_op.py).
# Build-Kontext = Repo-Wurzel:  docker build -f ops/Dockerfile.sync .
# ---------------------------------------------------------------------------
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json            apps/web/package.json
COPY packages/db/package.json         packages/db/package.json
COPY packages/shared/package.json     packages/shared/package.json
COPY services/sync/package.json       services/sync/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS runner
ENV NODE_ENV=production
RUN apk add --no-cache python3 py3-pip tini

# supercronic: container-taugliches cron (Logs nach stdout, respektiert ENV)
ARG SUPERCRONIC_VERSION=v0.2.33
ADD https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-amd64 /usr/local/bin/supercronic
RUN chmod +x /usr/local/bin/supercronic

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/sync/node_modules ./services/sync/node_modules
COPY packages ./packages
COPY services ./services
COPY package.json pnpm-workspace.yaml ./
COPY ops/crontab /app/crontab

# FinTS-venv im Image bauen (Bankzugang braucht python fints-Lib)
RUN python3 -m venv /app/services/sync/.fints-venv \
 && /app/services/sync/.fints-venv/bin/pip install --no-cache-dir -r /app/services/sync/fints/requirements.txt

WORKDIR /app/services/sync
ENTRYPOINT ["/sbin/tini", "--"]
# Standard: Cron-Loop. Für einmalige Läufe:  docker compose run --rm sync pnpm portal:pull
CMD ["supercronic", "/app/crontab"]
