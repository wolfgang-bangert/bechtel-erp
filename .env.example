# ===========================================================================
# werk – Umgebungsvariablen (Vorlage)
#
#   lokal:  cp .env.example .env   und Werte einsetzen  (.env ist gitignored)
#   VM:     /opt/werk/.env  (chmod 600) – dieselbe Datei, prod-Werte;
#           docker compose liest sie automatisch (Interpolation + env_file).
# ===========================================================================

# --- Domain / Deployment ---
WERK_DOMAIN=werk.bechtel-druck.de

# --- Supabase ---
# lokal: werk-dev (Ref mxdxgqmfnnxupsvtgvsb) · VM: werk-prod
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF=<ref>
# Next.js (Client, zur Build-Zeit eingebacken – müssen zu obigem Projekt passen)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- flux (AccurioPro Flux) ---
FLUX_API_BASE=https://flux.bechtel-druck.de/api
FLUX_API_KEY=
# HMAC-Secret für den Status-Webhook (POST /api/flux/webhook)
FLUX_WEBHOOK_SECRET=

# --- n8n (Zeitplan + Fehlerbenachrichtigung für Bank-Sync u.ä.) ---
# gemeinsames Secret für POST /api/n8n/trigger, /api/n8n/notify, GET /api/n8n/status
# (Header X-Werk-Secret). Generieren z.B. mit: openssl rand -hex 32
N8N_SHARED_SECRET=

# --- Onlineprinters Lieferantenportal ---
ONLINEPRINTERS_API_BASE=https://api.partner.onlineprinters.info
ONLINEPRINTERS_API_KEY=
ONLINEPRINTERS_API_USER=

# --- Hetzner Object Storage (S3) ---
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_BUCKET=werk-dokumente
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Keyline ---
KEYLINE_API_BASE=https://api.keyline.app
KEYLINE_API_KEY=

# --- Ninox (Altbestand-Import) ---
NINOX_API_BASE=https://api.ninox.com
NINOX_API_KEY=
NINOX_TEAM_ID=
NINOX_DATABASE_ID=
NINOX_CUSTOMER_TABLE_ID=

# --- BuchhaltungsButler ---
BB_API_BASE=https://webservice.buchhaltungsbutler.de/api/v1
BB_API_CLIENT=
BB_API_SECRET=
BB_API_KEY=

# --- DATEV-Export ---
DATEV_BERATER_NR=
DATEV_MANDANTEN_NR=
DATEV_WJ_BEGINN=
DATEV_SACHKONTO_LEN=

# --- Bank / FinTS (services/sync, Python-venv) ---
# je Bank: FINTS_PIN_<KUERZEL> in GROSSBUCHSTABEN; Banken in imports/fints.txt
FINTS_PIN_KSK=
FINTS_PIN_BWBANK=
FINTS_PIN_OBERBANK=
FINTS_PIN_VB=

# --- GoCardless (Bank Account Data) ---
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Mail (Eingangsrechnungen + Mahnungs-Weiterleitung) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DUNNING_FORWARD_TO=

# --- KI (Rechnungs-Extraktion) ---
ANTHROPIC_API_KEY=
